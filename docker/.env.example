# Keystore configuration for release signing
# Copy this file to .env and fill in your values

# Path to your keystore file (relative to project root)
KEYSTORE_FILE=keystore/release.jks

# Keystore password
KEYSTORE_PASSWORD=your_secure_password

# Key alias inside the keystore
KEY_ALIAS=profpay

# Key password
KEY_PASSWORD=your_key_password

# Optional: Bugfender API key
BUGFENDER_API_KEY=
